---
import { sections, docs, sectionsEn, docsEn } from '../data/nav';
import '../styles/global.css';

interface Props { title: string; description: string; section?: string; }
const { title, description, section } = Astro.props;
const path = Astro.url.pathname;
const isEnglish = path !== '/ja/' && !path.startsWith('/ja/');
const activeSections = isEnglish ? sectionsEn : sections;
const activeDocs = isEnglish ? docsEn : docs;
const englishPath = isEnglish ? path : (path.replace(/^\/ja/, '') || '/');
const japanesePath = isEnglish ? `/ja${path}` : path;
const siteBase = Astro.site ?? new URL('/', Astro.url.origin);
const preferredUrl = new URL(englishPath.replace(/^\//, ''), siteBase);
const japaneseUrl = new URL(japanesePath === '/' ? '' : japanesePath.replace(/^\//, ''), siteBase);
const canonicalUrl = isEnglish ? preferredUrl : japaneseUrl;
const siteName = isEnglish ? 'Gua Reference' : 'Gua 日本語リファレンス';
const fullTitle = `${title} | ${siteName}`;
const ogImageUrl = new URL('og-image.png', siteBase);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  url: canonicalUrl.href,
  image: ogImageUrl.href,
  inLanguage: isEnglish ? 'en' : 'ja',
  isPartOf: {
    '@type': 'WebSite',
    name: 'Gua Reference',
    url: siteBase.href,
  },
  about: {
    '@type': 'SoftwareApplication',
    name: 'Gua',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Windows',
    url: 'https://github.com/link1345/gua',
  },
};
---
<!doctype html>
<html lang={isEnglish ? 'en' : 'ja'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={preferredUrl} />
    <link rel="alternate" hreflang="ja" href={japaneseUrl} />
    <link rel="alternate" hreflang="x-default" href={preferredUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Gua Reference" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gua — Runtime UI Automation for Games" />
    <meta property="og:locale" content={isEnglish ? 'en_US' : 'ja_JP'} />
    <meta property="og:locale:alternate" content={isEnglish ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Gua — Runtime UI Automation for Games" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="topbar">
      <button class="menu-toggle" type="button" aria-label={isEnglish ? 'Open navigation menu' : 'ナビゲーションメニューを開く'} aria-controls="site-sidebar" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>
      <a class="brand" href={isEnglish ? '/' : '/ja/'} aria-label={isEnglish ? 'Gua Reference home' : 'Gua 日本語リファレンス ホーム'}>
        <span class="brand-mark">G</span><span>Gua <b>{isEnglish ? 'REFERENCE' : '日本語リファレンス'}</b></span>
      </a>
      <nav class="topnav" aria-label={isEnglish ? 'Primary navigation' : '主要ナビゲーション'}>
        <a href={isEnglish ? '/godot/' : '/ja/godot/'}>Godot</a><a href={isEnglish ? '/ai-coding/' : '/ja/ai-coding/'}>AI Playtesting</a><a href={isEnglish ? '/docs/' : '/ja/docs/'}>Docs</a><a href={isEnglish ? '/inspector/' : '/ja/inspector/'}>Inspector</a><a href={isEnglish ? '/mcp/' : '/ja/mcp/'}>MCP</a>
      </nav>
      <a class="lang-link" href={isEnglish ? japanesePath : englishPath}>{isEnglish ? '日本語' : 'English'}</a>
      <a class="github-link" href="https://github.com/link1345/gua" target="_blank" rel="noreferrer">GitHub ↗</a>
    </header>
    <div class="shell">
      <button class="menu-backdrop" type="button" aria-label={isEnglish ? 'Close navigation menu' : 'ナビゲーションメニューを閉じる'} tabindex="-1"></button>
      <aside class="sidebar" id="site-sidebar">
        <a class:list={["side-home", path === (isEnglish ? '/' : '/ja/') && 'active']} href={isEnglish ? '/' : '/ja/'}>{isEnglish ? 'Introduction' : 'はじめに'}</a>
        <div class="side-label">GUIDE</div>
        {activeSections.map((item) => (
          <div class="side-group">
            <a class:list={["side-parent", path.startsWith(item.href) && 'active']} href={item.href}>
              <i class={`dot ${item.accent}`}></i>{item.label}
            </a>
            {item.children.length > 0 && <div class="side-children">
              {item.children.map((child) => <a class:list={[path === child.href && 'active']} href={child.href}>{child.label}</a>)}
            </div>}
          </div>
        ))}
        <div class="side-label docs-label">DOCS / REFERENCE</div>
        <div class="side-children docs-nav">
          {activeDocs.map((item) => <a class:list={[path === item.href && 'active']} href={item.href}>{item.label}</a>)}
        </div>
        <div class="version-note"><span>{isEnglish ? 'TARGET' : '対象'}</span><strong>Gua / main + Unity preview</strong><small>Godot 4.7 · Unity 6 · Windows</small></div>
      </aside>
      <main class:list={["content", section && `section-${section}`]}>
        {!isEnglish && <div class="translation-note">英語版が正式な参照です。内容に差異がある場合は、<a href={englishPath}>英語版</a>を優先してください。</div>}
        <slot />
      </main>
    </div>
    <footer><span>{isEnglish ? 'Gua Reference' : 'Gua 日本語リファレンス'}</span><span>{isEnglish ? 'Official documentation' : '公式ドキュメント'}</span><a href="https://github.com/link1345/gua/blob/main/LICENSE">MIT License</a></footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const sidebar = document.querySelector<HTMLElement>('#site-sidebar');
      const backdrop = document.querySelector<HTMLButtonElement>('.menu-backdrop');

      const setMenuOpen = (open: boolean) => {
        sidebar?.classList.toggle('mobile-open', open);
        backdrop?.classList.toggle('visible', open);
        toggle?.classList.toggle('active', open);
        toggle?.setAttribute('aria-expanded', String(open));
        document.body.classList.toggle('menu-open', open);
      };

      toggle?.addEventListener('click', () => {
        setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true');
      });
      backdrop?.addEventListener('click', () => setMenuOpen(false));
      sidebar?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => setMenuOpen(false));
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });
    </script>
  </body>
</html>
